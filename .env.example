DATABASE_URL=postgresql://prospect:prospect@localhost:5433/prospect

# web: "postgres" (local, real data) | "demo" (public portfolio, fake fixtures)
DATA_SOURCE=postgres

# workers targeting
TARGET_DEPARTMENTS=75,92,93,94
# NAF prefixes: restauration, beaute, sport, commerce physique, BTP, sante
TARGET_NAF_PREFIXES=56,9602,9604,9313,47,43,8690
# couriers, VTC, real estate, holdings, head offices, mail-order, unknown
EXCLUDED_NAF_PREFIXES=5320,4932,4939,6820,6832,6420,7010,4791,4799,0000
CODEUR_KEYWORDS=site,web,wordpress,shopify,e-commerce,ecommerce,boutique,landing,react,next,automatisation,n8n,ia,chatbot,api,scraping

# local search engine used for website discovery (generate: python -c "import secrets;print(secrets.token_hex(32))")
SEARXNG_SECRET=change-me
SEARXNG_URL=http://localhost:8888

# daily pipeline time (worker container, Europe/Paris)
RUN_AT=07:00
